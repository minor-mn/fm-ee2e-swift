      retry_hint: "直したら L で確かめ直します。",
      unavailable: "Google Driveを使えません。",
    },
    // アップロード・ダウンロード
    uploading: "Google Drive にアップロード中…",
    uploading_remaining: "Google Drive にアップロード中…（残り {count} 件）",
    cannot_move: "{path} に移せません: {reason}",
    decrypting: "「{name}」を復号中…",
    cannot_make_temp: "一時フォルダーを作れません: {reason}",
  },
  icloud_pane: {
    // iCloud Drive のパネルを使えないときの表示
    placeholder: {
      checking: "確認中…",
      not_available: "iCloud Driveは使えません。",
      not_available_hint: "この Mac のシステム設定で iCloud Drive をオンにしてください。",
